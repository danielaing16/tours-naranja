# Copia este archivo a .env y completa los valores

SUPABASE_URL=https://TU_PROYECTO.supabase.co
SUPABASE_SERVICE_KEY=tu_service_role_key

JWT_SECRET=clave-larga-aleatoria-para-admin

PORT=3001

# Producción: URL del frontend (Vercel), sin barra final. Varias separadas por coma.
# FRONTEND_URL=https://tours-naranja.vercel.app

# Google AI Studio (gratis para pruebas): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Opcional: otro modelo, ej. gemini-2.0-flash-lite
# GEMINI_MODEL=gemini-2.0-flash
# Personaliza: IA adapta mensaje e itinerario al cliente (true por defecto si hay API key)
# GEMINI_PERSONALIZA=false

# Guardar cada solicitud Personaliza en planes_generados (historial admin). Por defecto: no.
# GUARDAR_PLANES_SOLICITUDES=true
